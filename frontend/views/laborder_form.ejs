<div class="row justify-content-center">
  <div class="col-md-9">
    <div class="card">
      <div class="card-header form-card-header">
        <h4 class="mb-0"><i class="bi bi-eyedropper me-2"></i>New Lab Order</h4>
      </div>
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
          </div>
        <% } %>
        <form action="/lab-orders" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Patient *</label>
              <select name="patient_id" class="form-select" required>
                <option value="">Select Patient</option>
                <% patients.forEach(p => { %>
                  <option value="<%= p.id %>"><%= p.name %> (<%= p.phone %>)</option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Priority</label>
              <select name="priority" class="form-select">
                <option value="routine">Routine</option>
                <option value="urgent">Urgent</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Tests * (total: <strong id="labTotal">&#8377;0</strong>)</label>
            <div class="row g-2">
              <% tests.forEach(t => { %>
                <div class="col-md-6">
                  <div class="form-check border rounded p-2">
                    <input type="checkbox" name="test_ids" value="<%= t.id %>" data-price="<%= t.price %>" class="form-check-input ms-1 lab-test-check" id="lt<%= t.id %>">
                    <label class="form-check-label ms-1" for="lt<%= t.id %>"><%= t.name %> <span class="text-muted">&mdash; &#8377;<%= t.price %></span></label>
                  </div>
                </div>
              <% }) %>
            </div>
            <% if (!tests.length) { %><p class="text-muted">No active tests. Ask an admin to add some in Lab Tests.</p><% } %>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create Order</button>
            <a href="/lab-orders" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
(function() {
  var total = document.getElementById('labTotal');
  function update() {
    var sum = 0;
    document.querySelectorAll('.lab-test-check:checked').forEach(function(c) {
      sum += parseFloat(c.getAttribute('data-price')) || 0;
    });
    total.textContent = '\u20B9' + sum.toLocaleString('en-IN');
  }
  document.querySelectorAll('.lab-test-check').forEach(function(c) {
    c.addEventListener('change', update);
  });
  update();
})();
</script>
