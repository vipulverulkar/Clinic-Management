<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-graph-up me-2"></i>Reports</h1>
    <p class="page-subtitle">Revenue and appointment analytics</p>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form action="/reports" method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="<%= from %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="<%= to %>">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Apply</button>
      </div>
      <div class="col-md-3">
        <div class="d-flex gap-2">
          <a href="/reports/revenue.csv?from=<%= from %>&to=<%= to %>" class="btn btn-outline-success flex-fill" title="Download revenue CSV"><i class="bi bi-download me-1"></i>Revenue</a>
          <a href="/reports/appointments.csv?from=<%= from %>&to=<%= to %>" class="btn btn-outline-success flex-fill" title="Download appointments CSV"><i class="bi bi-download me-1"></i>Visits</a>
        </div>
      </div>
    </form>
  </div>
</div>

<% if (revenue) { %>
<div class="row mb-4 g-3">
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card stat-green h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-cash-stack"></i></span>
      <div><p class="stat-value text-success">&#8377;<%= revenue.total_billed %></p><p class="stat-label">Total Billed</p></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card stat-blue h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-wallet2"></i></span>
      <div><p class="stat-value text-primary">&#8377;<%= revenue.total_collected %></p><p class="stat-label">Collected</p></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card stat-rose h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-exclamation-circle"></i></span>
      <div><p class="stat-value text-danger">&#8377;<%= revenue.outstanding %></p><p class="stat-label">Outstanding</p></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card stat-amber h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-receipt"></i></span>
      <div><p class="stat-value text-warning"><%= revenue.bill_count %></p><p class="stat-label">Bills</p></div>
    </div></div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-calendar3 me-1"></i>Daily Revenue</div>
      <div class="card-body">
        <% if (!revenue.by_day.length) { %><p class="text-muted mb-0">No billing data in range</p><% } else { %>
        <div class="table-responsive"><table class="table table-hover">
          <thead><tr><th>Date</th><th>Billed (&#8377;)</th><th>Collected (&#8377;)</th></tr></thead>
          <tbody><% revenue.by_day.forEach(d => { %>
            <tr><td><%= d.date %></td><td>&#8377;<%= d.billed %></td><td>&#8377;<%= d.collected %></td></tr>
          <% }) %></tbody>
        </table></div><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-pie-chart me-1"></i>By Status</div>
      <div class="card-body">
        <% Object.keys(revenue.by_status).forEach(s => { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge bg-<%= s === 'paid' ? 'success' : s === 'partial' ? 'warning' : 'danger' %>"><%= s %></span>
            <strong>&#8377;<%= revenue.by_status[s] %></strong>
          </div>
        <% }) %>
        <% if (!Object.keys(revenue.by_status).length) { %><p class="text-muted mb-0">No data</p><% } %>
      </div>
    </div>
  </div>
</div>
<% } %>

<% if (appts) { %>
<div class="row g-3 mt-1">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-flag me-1"></i>Appointments by Status (<%= appts.total %>)</div>
      <div class="card-body">
        <% Object.keys(appts.by_status).forEach(s => { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge bg-secondary"><%= s %></span><strong><%= appts.by_status[s] %></strong>
          </div>
        <% }) %>
        <% if (!Object.keys(appts.by_status).length) { %><p class="text-muted mb-0">No data</p><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-person-badge me-1"></i>By Doctor</div>
      <div class="card-body">
        <% Object.keys(appts.by_doctor).forEach(d => { %>
          <div class="d-flex justify-content-between align-items-center mb-2"><span><%= d %></span><strong><%= appts.by_doctor[d] %></strong></div>
        <% }) %>
        <% if (!Object.keys(appts.by_doctor).length) { %><p class="text-muted mb-0">No data</p><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-capsule me-1"></i>By Treatment</div>
      <div class="card-body">
        <% Object.keys(appts.by_treatment).forEach(t => { %>
          <div class="d-flex justify-content-between align-items-center mb-2"><span><%= t %></span><strong><%= appts.by_treatment[t] %></strong></div>
        <% }) %>
        <% if (!Object.keys(appts.by_treatment).length) { %><p class="text-muted mb-0">No data</p><% } %>
      </div>
    </div>
  </div>
</div>
<% } %>
